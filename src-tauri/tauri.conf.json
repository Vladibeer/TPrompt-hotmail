{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TPrompt",
  "version": "1.0.0",
  "identifier": "com.tprompt.app",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TPrompt",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
