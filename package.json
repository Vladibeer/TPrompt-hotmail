{
  "name": "tprompt",
  "productName": "TPrompt",
  "version": "1.0.0",
  "description": "TPrompt – телепромптър за Windows (Tauri) и Android (Capacitor)",
  "author": "TPrompt",
  "license": "MIT",
  "private": true,
  "scripts": {
    "vendor": "node scripts/vendor.js",
    "start": "npm run vendor && tauri dev",
    "dist:win": "npm run vendor && tauri build --bundles nsis",
    "android:sync": "npm run vendor && cap sync android && node scripts/android-patch.js",
    "android:open": "cap open android",
    "icons": "capacitor-assets generate --android",
    "tauri": "tauri"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "jsqr": "1.4.0",
    "mammoth": "1.6.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "@tauri-apps/cli": "^2.0.0"
  }
}
